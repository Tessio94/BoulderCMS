# Dockerfile.nginx
FROM nginx:alpine

# Copy custom Nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy public assets from the built app (for static serving)
COPY --from=payload-boulder /app/.next/static /usr/share/nginx/html/_next/static
COPY --from=payload-boulder /app/media /usr/share/nginx/html/media